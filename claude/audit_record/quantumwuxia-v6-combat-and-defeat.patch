+});
+
+test('nothing in a monastery kills you: attacking the abbot at any risk ends in mercy', () => {
+  const sim = disciple(); sim.character.hp = 3;
+  const abbot = npc(sim, 'npc-abbot-huiyuan'); abbot.locationId = sim.character.locationId;
