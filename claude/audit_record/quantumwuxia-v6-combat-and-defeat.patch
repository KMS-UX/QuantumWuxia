+          const text = roll % 2 ? `Attack ${p.npc.name}` : `Challenge ${p.npc.name} to a friendly duel`;
+          const r = run(sim, text, roll, risk);
+          assert.equal(JSON.stringify(sim), before, 'input mutated');
